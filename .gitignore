# Playback positions — 291 files of personal viewing history, and they
# contain the full path of every file ever opened. Never commit these.
watch_later/

# Streaming cache (mpv.conf points demuxer-cache-dir at ~/.cache/mpv, but
# guard against a future config change putting it here)
cache/

.DS_Store
# Single remembered sound level (scripts/global-sound.lua). Machine state, not
# config - and it changes every time the volume keys are touched.
sound-state.json
# The remembered p choice (scripts/fullscreen-mode.lua). Machine state too.
fullscreen-state.json

# Subtitles downloaded for a video whose own folder is read-only
# (scripts/subtitle-fetch.lua falls back to here). Someone else's work, and
# it names what has been watched.
subs-fetched/

# test rigs run from here import mpv-open, which leaves bytecode behind
__pycache__/

# MPV Remote, installed by install.sh from its own releases
# (github.com/ryudexter/mpv-remote); it is a signed build, not config.
scripts/mpv-remote/
