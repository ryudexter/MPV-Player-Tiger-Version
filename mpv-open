#!/usr/bin/env python3
"""Single-instance launcher for the mpv.app wrapper.

Lives OUTSIDE the app bundle on purpose: editing anything inside mpv.app
breaks its ad-hoc code signature, and re-signing changes the cdhash that
macOS ties privacy grants to, which re-triggers the "would like to access
files in your Desktop folder" prompt. Keeping the logic here means it can
be changed freely without disturbing the bundle.

Behaviour:
  * no instance running      -> launch mpv with the files
  * instance running         -> add the files to its playlist and play them
  * file already in playlist -> jump to it instead of adding a duplicate
  * file already playing     -> do nothing, so it keeps its position
"""
import fcntl, json, os, socket, subprocess, sys, time

SOCK  = "/tmp/mpv-single.sock"
LOCK  = "/tmp/mpv-single.lock"
MPV   = "/opt/homebrew/bin/mpv"
FLAGS = ["--force-window=immediate",
         "--input-ipc-server=" + SOCK,
         "--focus-on=all"]

def norm(p):
    try:
        return os.path.realpath(p)
    except OSError:
        return p

def push(files):
    """Send files to the running instance. Raises if there isn't one."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2.0)
    s.connect(SOCK)                      # fails fast if nothing is listening
    f = s.makefile("rwb")
    rid = [0]

    def cmd(c):
        rid[0] += 1
        f.write((json.dumps({"command": c, "request_id": rid[0]}) + "\n").encode())
        f.flush()
        while True:
            line = f.readline()
            if not line:
                return None
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if m.get("request_id") == rid[0]:      # skip async event lines
                return m.get("data")

    if files:
        pl    = cmd(["get_property", "playlist"]) or []
        known = [norm(e.get("filename", "")) for e in pl]
        cur   = next((i for i, e in enumerate(pl) if e.get("current")), None)

        # first file decides what we switch to
        target = known.index(norm(files[0])) if norm(files[0]) in known else None
        if target is None:
            target = len(known)
            cmd(["loadfile", files[0], "append"])
            known.append(norm(files[0]))

        # any extra files from a multi-selection, skipping ones already queued
        for path in files[1:]:
            if norm(path) not in known:
                cmd(["loadfile", path, "append"])
                known.append(norm(path))

        # Only switch if it is not already the current entry. Re-selecting the
        # playing file must be a no-op, otherwise it reloads from 0 and the
        # position is lost.
        if target != cur:
            # Save where the outgoing file got to first. playlist-play-index
            # does NOT write a watch-later entry on its own (loadfile replace
            # does), so without this, coming back to it would restart from 0.
            if cur is not None:
                cmd(["write-watch-later-config"])
            cmd(["playlist-play-index", target])

        # Clicking a file means "play this", so lift a pause. Without it,
        # re-opening a paused video just brings the window forward and sits
        # there frozen.
        cmd(["set_property", "pause", False])

    cmd(["set_property", "window-minimized", False])
    s.close()

def launch(files, extra=None):
    try:
        os.unlink(SOCK)                  # clear a stale socket
    except OSError:
        pass
    # anything after "--" is treated as a filename, so flags go before it
    subprocess.Popen([MPV] + FLAGS + (extra or []) + ["--"] + files,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)

def wait_for_socket(timeout=10.0):
    """Block until the freshly launched mpv is accepting IPC connections."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(0.5)
            s.connect(SOCK)
            s.close()
            return True
        except Exception:
            time.sleep(0.1)
    return False

def main():
    files = sys.argv[1:]
    # Finder splits a large selection (cmd-A on a folder) into several open
    # events, so multiple copies of this script can run at once. Without a
    # lock they all find no instance and all launch one, giving several
    # windows. Holding the lock until the new mpv is reachable means the
    # others fall through to push() and just add their files.
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        if files:
            try:
                push(files)
            except Exception:
                launch(files)
                wait_for_socket()
        else:
            try:
                push([])                 # just raise the existing window
            except Exception:
                launch([], extra=["--idle=once"])
                wait_for_socket()
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()

if __name__ == "__main__":
    main()
