#!/usr/bin/env python3
"""Single-instance launcher for the mpv.app wrapper (macOS) and for the
"mpv (Tiger Version)" desktop entry install.sh adds on Linux. Windows has its
own, windows/mpv-open.cs, built by install.ps1 - the same logic in C#.

Lives OUTSIDE the app bundle on purpose: editing anything inside mpv.app
breaks its ad-hoc code signature, and re-signing changes the cdhash that
macOS ties privacy grants to, which re-triggers the "would like to access
files in your Desktop folder" prompt. Keeping the logic here means it can
be changed freely without disturbing the bundle.

Behaviour:
  * no instance running      -> launch mpv with the files
  * instance running         -> add the files to its playlist and play them
  * file already in playlist -> jump to it instead of adding a duplicate
  * file already playing     -> do nothing, so it keeps its position
  * instance running         -> and bring it to the front, switching to its
                                fullscreen Space if that is where it is
                                (macOS; on Linux that is up to the desktop)
"""
import fcntl, json, os, shutil, socket, subprocess, sys, time

MAC = sys.platform == "darwin"

if MAC:
    SOCK  = "/tmp/mpv-single.sock"
    LOCK  = "/tmp/mpv-single.lock"
    # The player is started through a symlink to Homebrew's binary inside its
    # own app bundle, so macOS knows the running player as an app. Only an app
    # can be brought to the front from here - see bring_forward().
    BUNDLE = os.path.expanduser("~/.config/mpv/app/mpv-player.app")
    MPV    = BUNDLE + "/Contents/MacOS/mpv"
    if not os.path.exists(MPV):          # symlink broken or bundle gone: still
        MPV = "/opt/homebrew/bin/mpv"    # play, just without the raise
else:
    # Linux (and the BSDs). The socket goes in the per-user runtime dir: /tmp
    # is shared by every account on the machine, and a second user's launcher
    # would otherwise find the first user's player and hand it their files.
    # /tmp with the uid in the name when there is no runtime dir.
    run = os.environ.get("XDG_RUNTIME_DIR")
    if run and os.path.isdir(run):
        SOCK = os.path.join(run, "mpv-single.sock")
        LOCK = os.path.join(run, "mpv-single.lock")
    else:
        SOCK = "/tmp/mpv-single-%d.sock" % os.getuid()
        LOCK = "/tmp/mpv-single-%d.lock" % os.getuid()
    # A desktop entry is started with the session's PATH, so the mpv on it is
    # the one the user would get typing mpv - the distribution's, as a rule.
    BUNDLE = None
    MPV    = shutil.which("mpv") or "/usr/bin/mpv"
FLAGS = ["--force-window=immediate",
         "--input-ipc-server=" + SOCK,
         "--focus-on=all"]
# Extra flags for the player this starts, split on spaces. For testing (the CI
# runs it with --vo=null --ao=null); nothing in the setup sets it.
FLAGS += os.environ.get("MPV_TIGER_FLAGS", "").split()

def norm(p):
    try:
        return os.path.realpath(p)
    except OSError:
        return p

def push(files):
    """Send files to the running instance. Raises if there isn't one."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2.0)
    s.connect(SOCK)                      # fails fast if nothing is listening
    f = s.makefile("rwb")
    rid = [0]

    def cmd(c):
        rid[0] += 1
        f.write((json.dumps({"command": c, "request_id": rid[0]}) + "\n").encode())
        f.flush()
        while True:
            line = f.readline()
            if not line:
                return None
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if m.get("request_id") == rid[0]:      # skip async event lines
                return m.get("data")

    if files:
        pl    = cmd(["get_property", "playlist"]) or []
        known = [norm(e.get("filename", "")) for e in pl]
        cur   = next((i for i, e in enumerate(pl) if e.get("current")), None)

        # first file decides what we switch to
        target = known.index(norm(files[0])) if norm(files[0]) in known else None
        if target is None:
            target = len(known)
            cmd(["loadfile", files[0], "append"])
            known.append(norm(files[0]))

        # any extra files from a multi-selection, skipping ones already queued
        for path in files[1:]:
            if norm(path) not in known:
                cmd(["loadfile", path, "append"])
                known.append(norm(path))

        # Only switch if it is not already the current entry. Re-selecting the
        # playing file must be a no-op, otherwise it reloads from 0 and the
        # position is lost.
        if target != cur:
            # Save where the outgoing file got to first. playlist-play-index
            # does NOT write a watch-later entry on its own (loadfile replace
            # does), so without this, coming back to it would restart from 0.
            if cur is not None:
                cmd(["write-watch-later-config"])
            cmd(["playlist-play-index", target])

        # Clicking a file means "play this", so lift a pause. Without it,
        # re-opening a paused video just brings the window forward and sits
        # there frozen.
        cmd(["set_property", "pause", False])

        # ...and play it at 1x. speed is a global property and
        # reset-on-next-file is empty, so without this a 4x session leaks into
        # every file opened afterwards - and because this launcher is
        # single-instance, "open another video" is a loadfile into the SAME
        # process, which looks like a fresh start but is not one.
        # Deliberately here and not in mpv.conf: reset-on-next-file=speed would
        # also reset when an episode auto-advances. This fires only on a
        # user-initiated open, so playlist playback keeps whatever speed it is
        # running at. Unconditional, like the pause lift above - re-clicking
        # the file that is already playing counts as opening it.
        # KNOWN RACE: if skiptosilence.lua is mid-skip, switching files fires
        # end-file -> restoreState(), which writes its saved speed back. That
        # can land after this and keep the old speed for one open. Rare enough
        # to document rather than poll for.
        cmd(["set_property", "speed", 1.0])

    cmd(["set_property", "window-minimized", False])
    focused = cmd(["get_property", "focused"])
    pid     = cmd(["get_property", "pid"])
    s.close()
    if not focused:
        bring_forward(pid)

def bring_forward(pid):
    """Put the running player in front of whatever the user is in.

    mpv's own --focus-on=all asks macOS for exactly this on every new file, and
    macOS refuses it: since macOS 14 an app in the background cannot bring
    itself forward. Measured 2026-09-26 with mpv fullscreen on its own Space
    and Finder in front - NSApp.activate (what focus-on does),
    NSRunningApplication activateWithOptions and `lsappinfo setfront` all left
    Finder in front. `open -a` on the running app is honoured, and switches to
    its fullscreen Space to do it, in ~0.08s - also from a window that is
    behind others, un-minimised, or hidden. But `open -a` names an app bundle,
    which a bare binary is not: hence BUNDLE.
    """
    if not pid or not MAC:
        return
    try:
        # Only when macOS has THIS process down as our bundle. An instance
        # started any other way (a bare binary, or from before the bundle
        # existed) is not, and `open -a` then raises nothing: it launches a
        # second, empty player from the bundle, which quits at once for want
        # of a file (measured - the log shows the launch and the exit).
        info = subprocess.run(["/usr/bin/lsappinfo", "info", "-only", "bundlepath", str(pid)],
                              capture_output=True, text=True, timeout=5).stdout
        if not any('bundle path="%s"' % p in info for p in (BUNDLE, norm(BUNDLE))):
            return
        subprocess.run(["/usr/bin/open", "-a", BUNDLE], timeout=10,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def launch(files, extra=None):
    try:
        os.unlink(SOCK)                  # clear a stale socket
    except OSError:
        pass
    # Linux: pipx puts yt-dlp, subliminal and ffsubsync in ~/.local/bin, which
    # a desktop session does not always have on PATH (Ubuntu adds it at login
    # only if it existed then; Fedora only in interactive shells). The player
    # gets it either way, so mpv's YouTube hook finds yt-dlp.
    env = None
    if not MAC:
        env = dict(os.environ)
        local_bin = os.path.expanduser("~/.local/bin")
        if local_bin not in env.get("PATH", "").split(os.pathsep):
            env["PATH"] = local_bin + os.pathsep + env.get("PATH", "/usr/bin:/bin")
    # anything after "--" is treated as a filename, so flags go before it
    subprocess.Popen([MPV] + FLAGS + (extra or []) + ["--"] + files,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True, env=env)

def wait_for_socket(timeout=10.0):
    """Block until the freshly launched mpv is accepting IPC connections."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(0.5)
            s.connect(SOCK)
            s.close()
            return True
        except Exception:
            time.sleep(0.1)
    return False

def main():
    files = sys.argv[1:]
    # Finder splits a large selection (cmd-A on a folder) into several open
    # events, so multiple copies of this script can run at once. Without a
    # lock they all find no instance and all launch one, giving several
    # windows. Holding the lock until the new mpv is reachable means the
    # others fall through to push() and just add their files.
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        if files:
            try:
                push(files)
            except Exception:
                launch(files)
                wait_for_socket()
        else:
            try:
                push([])                 # just raise the existing window
            except Exception:
                launch([], extra=["--idle=once"])
                wait_for_socket()
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()

if __name__ == "__main__":
    main()
